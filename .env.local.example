# Copy to .env.local and fill in. None of these are required to run `npm run
# dev` — the project falls back to file-based content and local uploads when
# they're missing. They're required only at production cutover.

# ---------------------------------------------------------------------------
# Public site URL (used for canonicals + absolute URLs in JSON-LD).
NEXT_PUBLIC_SITE_URL=https://unimonks.co.in

# ---------------------------------------------------------------------------
# Neon Postgres
# DATABASE_URL is the pooled connection string for application queries.
# DATABASE_URL_UNPOOLED is the direct connection used by migrations only.
DATABASE_URL=postgres://user:password@ep-xxx-pooler.region.aws.neon.tech/unimonks?sslmode=require
DATABASE_URL_UNPOOLED=postgres://user:password@ep-xxx.region.aws.neon.tech/unimonks?sslmode=require

# ---------------------------------------------------------------------------
# Cloudflare R2 (image storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=unimonks-media
# Public-facing URL for uploaded files. Either the R2 public bucket URL
# (https://pub-...r2.dev) or a custom domain mapped to the bucket.
R2_PUBLIC_BASE_URL=https://media.unimonks.co.in

# ---------------------------------------------------------------------------
# Admin authentication
# Legacy fallback for dev: when DATABASE_URL is missing the admin still
# protects /admin using this single password. Once the users table exists,
# real user accounts take over.
ADMIN_PASSWORD=

# Used to seed the first owner account into the users table the first time
# the new auth runs against an empty DB. Rotate the password after first
# login.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
